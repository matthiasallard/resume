{
  "name": "hugo-blox-resume-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Resume starter template for Hugo Blox with Tailwind CSS v4",
  "scripts": {
    "bib": "python scripts/bib2hugo.py",
    "dev": "pnpm run bib && hugo server --disableFastRender",
    "build": "pnpm run bib && hugo --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
